    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fila = $('Palabras activas').item.json;\nconst segs = Array.isArray($json.segments) ? $json.segments : [];\nconst norm = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst palabra = norm(fila.palabra).trim();\nconst previo = Number(fila.segmentos_revisados);\nlet encontrados = [];\nif (previo >= 0 && palabra && segs.length > previo) {\n  encontrados = segs.slice(previo).filter(s => norm(s.text).includes(palabra)).map(s => (s.speaker ? s.speaker + ': ' : '') + String(s.text || '').trim());\n}\nreturn { json: { fila_id: fila.id, chat_id: fila.chat_id, meeting_id: fila.meeting_id, palabra: fila.palabra, total: segs.length, encontrada: encontrados.length > 0, frases: encontrados.slice(0, 3).join('\\n') } };"
      },
